{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubsetJuliaVM Canonical CST",
  "type": "object",
  "required": [
    "version",
    "root",
    "diagnostics"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/node"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "kind",
        "span",
        "children",
        "value",
        "flags"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "span"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    }
  }
}
